# Python cache
__pycache__/
*.py[cod]
*.pyo

# Dataset files (never commit — too large, each teammate keeps their own local copy)
dataset/
dataset_parquet/
*.tsv
*.csv.gz

# Outputs (regenerated by pipeline, not source-controlled)
output/*.tsv
output/**/*.tsv

# Model artifacts (usually large)
models/*.bin
models/*.pt
models/*.safetensors
*.pkl
*.joblib

# Environment / IDE
.venv/
venv/
env/
.env
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store

# Logs
*.log